# Archived/unused files
archived/

# Build-time copy of the shared package staged by scripts/deploy_job.sh
permutation_cloudrun/job-worker/aamos_concordance/
aamos_concordance/_build_info.py

# Raw data lives in data/raw/ (never committed); only the manifest is tracked
data/raw/*
!data/raw/MANIFEST.sha256
!data/raw/README.md

# Large cache files
permutation_cloudrun/aggregator/batch_results_cache*.json
permutation_cloudrun/aggregator/*.parquet

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# API keys (safety)
.env

# Reference papers
s41597-023-02241-9.pdf

# Sensitive results (contain patient feedback text)
results/*/concordant/sentiment_analysis/full_results.csv
results/*/concordant/sentiment_analysis/main_text/analysis_summary.txt
results/v2/comparisons/*/*/sentiment_analysis/full_results.csv
results/v2/comparisons/*/*/sentiment_analysis/main_text/analysis_summary.txt

# results/v1 is frozen; v2 world outputs are committed except large per-permutation parquets
results/v2/worlds/*/null.parquet
results/v2/worlds/*/null_per_config.parquet
results/v2/worlds/*/null*.parquet.provenance.json

